# MeetingGuard AI - app environment (template)
#
# Copy to `.env` for local development (`cp env.example .env`) and fill in the values.
# `.env*` files are git-ignored and never uploaded to EAS (.easignore). For EAS cloud builds
# create the same variables as EAS environment variables (Expo dashboard -> Project ->
# Environment variables, or `eas env:create`), and pull them for local development with
# `eas env:pull --environment development`.
#
# !!! IMPORTANT - READ BEFORE ADDING ANYTHING HERE !!!
# Every EXPO_PUBLIC_* value is compiled into the JavaScript bundle and can be read by anyone who
# has the APK/IPA. Only PUBLIC identifiers belong here. NEVER put secrets in this file or in any
# EXPO_PUBLIC_* variable: no OpenAI API key, no Google OAuth client secret, no service-account
# JSON, no Stripe/webhook secrets, no JWT secrets. Secrets live ONLY in Firebase Functions
# secrets, for example:
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET
#
# Keys marked [required] must be set; otherwise the app shows an "App not configured" screen
# instead of starting (see src/config/env.ts). Comments must stay on their own lines.

# --- Firebase web app config (public) ---------------------------------------------------------
# Firebase console -> Project settings -> General -> "Your apps" -> Web app -> "SDK setup and
# configuration" -> Config. These identify the project; access is enforced by Firebase Auth and
# the Firestore security rules, not by keeping these values hidden.
# [required] apiKey (starts with "AIza")
EXPO_PUBLIC_FIREBASE_API_KEY=
# [required] authDomain, e.g. my-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# [required] projectId, e.g. my-project
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# [required] storageBucket, e.g. my-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# [required] messagingSenderId (digits only)
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# [required] appId, e.g. 1:1234567890:web:abc123
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Sign-In OAuth client IDs (public) --------------------------------------------------
# Google Cloud console (same project as Firebase) -> APIs & Services -> Credentials.
# Client IDs are public. The client SECRET must never be placed here.
# [required] ID of the "Web client (auto created by Google Service)"; used as webClientId -
# Firebase accepts Google idTokens issued for this client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# [required on iOS] iOS OAuth client ID (bundle id com.meetingguard.ai).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional: Android OAuth client ID. Google needs one Android client per signing SHA-1 (debug
# keystore, EAS upload key, Google Play app signing key) even if this value is not used by code.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Optional, build time only (read by app.config.js): reversed iOS client ID used as the Google
# Sign-In iOS URL scheme, e.g. com.googleusercontent.apps.1234-abcd. If empty it is derived from
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# --- Microsoft / Outlook calendar sync (public, optional) --------------------------------------
# Azure portal -> App registrations (setup guide: docs/SETUP.md section 10). Leave both empty to
# hide the whole Outlook feature. Client IDs are public (PKCE, no client secret is used or needed).
# Optional: "Application (client) ID" of the Azure app registration (a GUID).
EXPO_PUBLIC_MSAL_CLIENT_ID=
# Optional: sign-in audience. "common" (default) = any Microsoft account (personal + work/school);
# "organizations" / "consumers" / a tenant GUID or verified domain narrow it.
EXPO_PUBLIC_MSAL_TENANT=

# --- Google Tasks sync switch (public, optional) ---------------------------------------------
# Google Tasks two-way sync (setup guide: docs/v1/SETUP.md section 4.6) is ON by default. Set the
# literal value "off" in store builds until Google verifies the tasks scope; the card is then hidden.
EXPO_PUBLIC_GOOGLE_TASKS_SYNC=

# --- In-app subscriptions / RevenueCat (public, optional) --------------------------------------
# RevenueCat dashboard -> Project -> API keys -> "Public SDK keys" -> Google Play
# (setup guide: docs/SETUP.md section 11). Leave empty to keep purchases OFF: the Plans screen
# then shows the catalog with "Subscriptions coming soon" and no purchase buttons.
# This is a PUBLIC SDK key ("goog_..."); the RevenueCat SECRET API key and the webhook
# Authorization value must never be placed here (webhook secret: `firebase functions:secrets:set
# REVENUECAT_WEBHOOK_AUTH`; reconciliation secret: REVENUECAT_SECRET_KEY, functions only).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Optional: the matching PUBLIC Apple SDK key ("appl_...") from the same API keys page (the App
# Store app; setup guide: docs/SETUP.md section 11). Leave empty to keep iOS purchases OFF while
# Android purchases keep working (and vice versa) - each platform reads only its own key.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=

# --- Crash reporting (public) ------------------------------------------------------------------
# Optional: Sentry -> Project settings -> Client Keys (DSN). A DSN can only send events, so it is
# public. Leave empty to disable Sentry.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: development | preview | production (reported as the Sentry environment).
EXPO_PUBLIC_APP_ENV=development
# Build-time Sentry settings (NOT EXPO_PUBLIC_; read by the Sentry config plugin during EAS
# builds to upload source maps). Set SENTRY_AUTH_TOKEN only as an EAS "secret" variable.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- Firebase Cloud Functions / local emulators ------------------------------------------------
# Optional: region of the callable functions; must match where they are deployed.
EXPO_PUBLIC_FUNCTIONS_REGION=us-central1
# Optional: "1" connects development builds to the local Firebase emulators.
EXPO_PUBLIC_USE_EMULATORS=
# Optional: emulator host. Default 10.0.2.2 (Android emulator -> host machine); use your
# computer's LAN IP for a physical device.
EXPO_PUBLIC_EMULATOR_HOST=
