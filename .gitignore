# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
# Keep .easignore in sync with this file (EAS uses .easignore INSTEAD of .gitignore).

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `npx expo prebuild` (Continuous Native Generation)
/android
/ios
.kotlin/
*.orig.*

# Signing material and credentials (never commit; EAS manages remote credentials)
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
service-account*.json
*-service-account.json

# Environment files (real values live in EAS environment variables / local .env only)
.env
.env.*
!env.example
!.env.example

# Private client material (credentials, contracts) - must never be committed
reference/

# Firebase Cloud Functions build output
functions/lib/
functions/node_modules/

# Metro
.metro-health-check*

# Test / tooling output
coverage/
*.tsbuildinfo
.eslintcache

# Logs and debug output
logs/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.swo
*~
