# EAS Build uses this file INSTEAD of .gitignore when uploading the project.
# It mirrors .gitignore and additionally keeps server-side code and private
# material out of the build archive. Keep both files in sync.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated on the build server (Continuous Native Generation).
# Only the TOP-LEVEL android/ios dirs: modules/*/android is the local Expo module's
# source (mg-fullscreen-alarm) and MUST be uploaded, or EAS builds lose the module.
/android
/ios

# Local Expo modules: Gradle build output (generated when the app builds)
modules/*/android/build/
.kotlin/
*.orig.*

# Signing material and credentials (EAS uses remote credentials)
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
service-account*.json
*-service-account.json

# Environment files - never upload; configure values as EAS environment variables
.env
.env.*
!env.example
!.env.example

# Private client material (credentials, contracts)
reference/

# Firebase backend (Cloud Functions, rules, emulator data) is deployed separately
functions/
.firebase/
firebase-debug.log
firestore-debug.log

# Metro
.metro-health-check*

# Test / tooling output
coverage/
*.tsbuildinfo
.eslintcache

# Logs and debug output
logs/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# Editors and OS
.git/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
